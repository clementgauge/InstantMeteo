{
  "name": "instant-meteo-cloudflare-d1-api",
  "version": "1.0.0",
  "description": "API Cloudflare Workers & D1 pour le classement compétitif et la carte collaborative d'Instant Météo",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create meteo-competitive-db",
    "d1:init-local": "wrangler d1 execute meteo-competitive-db --local --file=./schema.sql",
    "d1:init-prod": "wrangler d1 execute meteo-competitive-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.78.0"
  }
}
